# --- Secrets / environment ---
.env
.env.local
*.local

# --- Database backups produced by the 1-Click Backup feature ---
*.sql
# Keep versioned migrations tracked (git only treats '#' as a comment marker
# when it's the first character of the line, so this note must live above the
# pattern, not trail it - a trailing '#' would be parsed as literal pattern
# text and silently break the negation).
!src/migrations/*.sql
taskflow_backup_*.json

# --- Dependencies ---
/vendor/
node_modules/          # any depth (e.g. mcp-server/node_modules)
composer.lock

# --- Editor / OS cruft ---
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# --- Logs ---
*.log
