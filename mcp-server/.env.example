# TaskFlow MCP server - database connection.
# Copy to `.env` (git-ignored) and point at the same MySQL the PHP app uses.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=dev_taskflow
DB_USER=root
DB_PASS=change-me

# reconcile.js: consecutive orphaned resumes allowed before a ticket is
# auto-blocked (On Hold) instead of resumed again. Optional, defaults to 3.
RESUME_ATTEMPT_LIMIT=3
