# TaskFlow environment - copy to `.env` and adjust.
#   cp .env.example .env
# The .env file is git-ignored; never commit real credentials.
# Compose reads these for ${VAR} substitution in docker-compose.yml.

# Hostname of the MySQL server (service name on homeserver-net).
DB_HOST=mysql

# MySQL port.
DB_PORT=3306

# Application database (created automatically by config/migrate.php if missing).
DB_NAME=dev_taskflow

# MySQL credentials.
DB_USER=root
DB_PASS=change-me
